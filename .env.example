# ── Supabase ──────────────────────────────────────────────────────────────
# From your Supabase project: Project Settings → API.
# The anon key is safe to expose to the browser (NEXT_PUBLIC_ prefix) — it
# only grants whatever the Row Level Security policies allow.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service role key bypasses Row Level Security entirely. Used ONLY in
# server-side code (never prefixed NEXT_PUBLIC_, never sent to the browser).
# Needed from Phase 7 (admin dashboard) onward.
SUPABASE_SERVICE_ROLE_KEY=

# ── Google OAuth (added in Phase 4) ─────────────────────────────────────────
# These are NOT app env vars. Google sign-in is handled by Supabase Auth,
# so the Google OAuth client ID/secret are pasted into the Supabase
# dashboard (Authentication → Providers → Google), not here. See the
# README for the exact steps. Supabase also manages session cookies
# itself, so there's no separate session-secret variable to set.

# ── Mailgun (added in Phase 6) ──────────────────────────────────────────────
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_ADDRESS="Common Goods <orders@yourdomain.com>"

# ── Flutterwave (added in Phase 8) ──────────────────────────────────────────
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# ── App ──────────────────────────────────────────────────────────────────
# Used for building absolute URLs (emails, OAuth redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000
